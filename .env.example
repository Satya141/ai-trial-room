# AI Trial Room - environment template
#
#   cp .env.example .env
#
# .env is gitignored. NEVER commit a real token.

# --- secrets ---------------------------------------------------------------- #
# Not required for the Apache-2.0 models, but avoids anonymous rate limits.
HF_TOKEN=

# --- resolution ------------------------------------------------------------- #
AITR_WIDTH=768
AITR_HEIGHT=1024

# --- precision & memory ----------------------------------------------------- #
# auto | bfloat16 | float16 | float32   (T4 has no usable bf16 - use float16)
AITR_DTYPE=auto
# auto | none | fp8 | int4              (int4 needs the nunchaku package)
AITR_QUANTIZE=auto
AITR_MODEL_CPU_OFFLOAD=1
AITR_SEQ_CPU_OFFLOAD=0
AITR_ATTENTION_SLICING=1
AITR_VAE_SLICING=1
AITR_VAE_TILING=1
# Heavy models allowed in VRAM simultaneously. Keep at 1 on a 16GB card.
AITR_MAX_RESIDENT_BACKENDS=1

# --- sampling --------------------------------------------------------------- #
AITR_STEPS=30
AITR_TRUE_CFG=4.0
AITR_SEED=-1

# --- quality ---------------------------------------------------------------- #
# fast | balanced | best.  "best" adds a second pass over the pallu / dupatta,
# which roughly doubles generation time.
AITR_PRESET=balanced

# --- identity preservation -------------------------------------------------- #
# Face-blend opacity, 0.5-1.0. Lower lets more generated lighting through.
AITR_IDENTITY_STRENGTH=0.92
# Laplacian pyramid blending (1) keeps facial detail crisp while lighting
# cross-fades. Set to 0 for a plain alpha composite.
AITR_IDENTITY_LAPLACIAN=1
AITR_IDENTITY_LEVELS=5
# Tone-match the original face to the relit frame before blending.
AITR_MATCH_SKIN_TONE=1
# Abort the face blend if the head moved more than this fraction of face width.
AITR_MAX_FACE_DRIFT=0.35

# --- output validation ------------------------------------------------------ #
# Flag results with a repainted background, an unchanged garment, big exposure
# drift, or no detectable face. Warnings only - nothing is ever rejected.
AITR_VALIDATE=1

# --- licensing -------------------------------------------------------------- #
# KEEP THIS AT 0 FOR ANY DEPLOYMENT YOU CHARGE FOR.
# Setting it to 1 enables CatVTON (CC BY-NC-SA 4.0), whose output may not be sold.
ALLOW_NONCOMMERCIAL=0

# --- server ----------------------------------------------------------------- #
AITR_PORT=7860
AITR_SHARE=0
AITR_LOG_LEVEL=INFO

# --- privacy ---------------------------------------------------------------- #
# Also delete generated outputs after they are handed to the browser.
AITR_DELETE_OUTPUTS=0

# --- optional overrides ----------------------------------------------------- #
# AITR_QWEN_REPO=Qwen/Qwen-Image-Edit-2511
# AITR_FLUX_REPO=black-forest-labs/FLUX.2-klein-4B
# AITR_PARSING_REPO=mattmdjaga/segformer_b2_clothes
# AITR_REMBG_MODEL=u2net
# AITR_CATVTON_REPO=zhengchong/CatVTON
# AITR_CATVTON_PATH=third_party/CatVTON
# AITR_CACHE_DIR=.cache
